                    "type": "string",
                    "example": "Mario"
                  },
                  "cognome": {
                    "type": "string",
                    "example": "Rossi"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "mario.rossi@example.com"
                  }
