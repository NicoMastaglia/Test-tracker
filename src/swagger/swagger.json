      "/api/users/{id}/role": {
        "patch": {
          "tags": ["Users"],
          "summary": "Aggiorna ruolo utente per ID",
          "description": "Aggiorna il ruolo di un utente specifico tramite ID. Richiede il token JWT nell'header Authorization come Bearer token.",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              },
              "description": "ID dell'utente",
              "example": 1
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["user", "admin", "superadmin"],
                      "example": "admin"
                    }
                  },
                  "required": ["role"]
                },
                "example": {
                  "role": "admin"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Ruolo aggiornato con successo",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/SuccessMessage"
                  },
                  "example": {
                    "message": "Ruolo aggiornato con successo"
                  }
                }
              }
            },
            "400": {
              "description": "Ruolo non valido",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorMessage"
                  },
                  "example": {
                    "message": "Ruolo non valido"
                  }
                }
              }
            },
            "401": {
