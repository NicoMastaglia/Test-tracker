  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Inserire il token JWT come: Bearer <token>"
      }
    },
    "schemas": {
      "WelcomeMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Benvenuto!"
          }
        },
        "required": ["message"]
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ErrorWithDetail": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "specific": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          },
          "role": {
            "type": "string",
            "enum": ["user", "admin", "superadmin"],
            "example": "user"
          }
        },
        "required": ["name", "surname", "email", "password", "role"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          }
        },
        "required": ["email", "password"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "role": {
            "type": "string",
            "example": "user"
          }
        },
        "required": ["id", "name", "surname", "email", "role"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login utente"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "JWT da inviare nell'header Authorization delle route protette",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["message", "user", "token"]
      },
      "UsersListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Lista utenti"
          }
        },
        "required": ["message"]
      },
      "ProjectsListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Lista progetti"
          }
        },
        "required": ["message"]
      },
      "ProjectCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Progetto Alpha"
          },
          "description": {
            "type": "string",
            "example": "Descrizione del progetto Alpha"
          }
        },
        "required": ["name"]
      },
      "ProjectResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Progetto Alpha"
          },
          "description": {
            "type": "string",
            "example": "Descrizione del progetto Alpha"
          }
        },
        "required": ["id", "name"]
      }
    }
  }
