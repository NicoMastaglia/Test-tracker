          "401": {
            "description": "Token mancante o non valido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "examples": {
                  "missingToken": {
                    "value": {
                      "message": "Token mancante o formato non valido"
                    }
                  },
                  "invalidToken": {
                    "value": {
                      "message": "Token non valido"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Utente non trovato",
