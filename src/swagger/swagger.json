{
  "openapi": "3.0.3",
  "info": {
    "title": "Test Tracker API",
    "version": "1.0.0",
    "description": "Documentazione completa delle API del progetto Test Tracker per supportare il frontend e il test delle route. Le API protette richiedono il token JWT nell'header Authorization come Bearer token."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Server locale di sviluppo"
    }
  ],
  "tags": [
    {
      "name": "Main",
      "description": "Endpoint pubblici di benvenuto e fallback"
    },
    {
      "name": "Auth",
      "description": "Registrazione, autenticazione e logout utenti"
    },
    {
      "name": "Users",
      "description": "Gestione e consultazione utenti"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Main"],
        "summary": "Messaggio di benvenuto",
        "description": "Endpoint pubblico principale dell'applicazione.",
        "security": [],
        "responses": {
          "200": {
            "description": "Messaggio restituito correttamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WelcomeMessage"
                },
                "example": {
                  "message": "Benvenuto!"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registra un nuovo utente",
        "description": "Crea un nuovo utente con nome, cognome, email, password e ruolo. Questa route è documentata come protetta da token JWT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Mario",
                "surname": "Rossi",
                "email": "mario.rossi@example.com",
                "password": "Password123!",
                "role": "user"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utente registrato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                },
                "example": {
                  "message": "Utente registrato con successo"
                }
              }
            }
          },
          "400": {
            "description": "Campi mancanti o ruolo non valido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "Tutti i campi sono obbligatori"
                    }
                  },
                  "invalidRole": {
                    "value": {
                      "message": "Il ruolo non valido"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore del server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithDetail"
                },
                "example": {
                  "message": "Errore del server",
                  "specific": "Duplicate entry 'mario.rossi@example.com' for key 'email'"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica un utente",
        "description": "Verifica email e password e restituisce un token JWT insieme ai dati utente. Questa route è pubblica e non richiede token in ingresso.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "mario.rossi@example.com",
                "password": "Password123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login effettuato correttamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "message": "Login utente",
                  "user": {
                    "id": 1,
                    "name": "Mario",
                    "surname": "Rossi",
                    "email": "mario.rossi@example.com",
                    "role": "user"
                  },
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Campi mancanti",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Email e password sono obbligatori"
                }
              }
            }
          },
          "401": {
            "description": "Password non valida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Password non valida"
                }
              }
            }
          },
          "404": {
            "description": "Utente non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Utente non trovato"
                }
              }
            }
          },
          "500": {
            "description": "Errore del server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithDetail"
                },
                "example": {
                  "message": "Errore del server",
                  "specific": "Internal error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Effettua il logout",
        "description": "Logout documentato come operazione protetta da token JWT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout effettuato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                },
                "example": {
                  "message": "Logout effettuato con successo"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Elenco utenti",
        "description": "Restituisce la lista utenti. La route è documentata come protetta da token JWT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista utenti disponibile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersListResponse"
                },
                "example": {
                  "message": "Lista utenti"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Inserire il token JWT come: Bearer <token>"
      }
    },
    "schemas": {
      "WelcomeMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Benvenuto!"
          }
        },
        "required": ["message"]
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ErrorWithDetail": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "specific": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          },
          "role": {
            "type": "string",
            "enum": ["user", "admin", "superadmin"],
            "example": "user"
          }
        },
        "required": ["name", "surname", "email", "password", "role"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          }
        },
        "required": ["email", "password"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Mario"
          },
          "surname": {
            "type": "string",
            "example": "Rossi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mario.rossi@example.com"
          },
          "role": {
            "type": "string",
            "example": "user"
          }
        },
        "required": ["id", "name", "surname", "email", "role"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login utente"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "JWT da inviare nell'header Authorization delle route protette",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["message", "user", "token"]
      },
      "UsersListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Lista utenti"
          }
        },
        "required": ["message"]
      }
    }
  }
}
