          }
        }
      }
    },
    "/api/users/me/password": {
      "patch": {
        "tags": ["Users"],
        "summary": "Aggiorna password utente autenticato",
        "description": "Aggiorna la password dell'utente autenticato. Richiede il token JWT nell'header Authorization come Bearer token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Oldpassword": {
                    "type": "string",
                    "format": "password",
                    "example": "PasswordVecchia123!"
                  },
                  "Newpassword": {
                    "type": "string",
                    "format": "password",
                    "example": "PasswordNuova123!"
                  }
                },
                "required": ["Oldpassword", "Newpassword"]
              },
              "example": {
                "Oldpassword": "PasswordVecchia123!",
                "Newpassword": "PasswordNuova123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password aggiornata con successo",
