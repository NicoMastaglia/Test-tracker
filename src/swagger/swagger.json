{
  "openapi": "3.0.3",
  "info": {
    "title": "Test Tracker API",
    "version": "1.0.0",
    "description": "Documentazione completa delle API del progetto Test Tracker per supportare il frontend e il test delle route. Le API protette richiedono il token JWT nell'header Authorization come Bearer token."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Server locale di sviluppo"
    }
  ],
  "tags": [
    {
      "name": "Main",
      "description": "Endpoint pubblici di benvenuto e fallback"
    },
    {
      "name": "Auth",
      "description": "Registrazione, autenticazione e logout utenti"
    },
    {
      "name": "Users",
      "description": "Gestione e consultazione utenti"
    },
    {
      "name": "Projects",
      "description": "Gestione e consultazione progetti"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Main"],
        "summary": "Messaggio di benvenuto",
        "description": "Endpoint pubblico principale dell'applicazione.",
        "security": [],
        "responses": {
          "200": {
            "description": "Messaggio restituito correttamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WelcomeMessage"
                },
                "example": {
                  "message": "Benvenuto!"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registra un nuovo utente",
        "description": "Crea un nuovo utente con nome, cognome, email, password e ruolo. Questa route è documentata come protetta da token JWT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Mario",
                "surname": "Rossi",
                "email": "mario.rossi@example.com",
                "password": "Password123!",
                "role": "user"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utente registrato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                },
                "example": {
                  "message": "Utente registrato con successo"
                }
              }
            }
          },
          "400": {
            "description": "Campi mancanti o ruolo non valido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "Tutti i campi sono obbligatori"
                    }
                  },
                  "invalidRole": {
                    "value": {
                      "message": "Il ruolo non valido"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore del server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithDetail"
                },
                "example": {
                  "message": "Errore del server",
                  "specific": "Duplicate entry 'mario.rossi@example.com' for key 'email'"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica un utente",
        "description": "Verifica email e password e restituisce un token JWT insieme ai dati utente. Questa route è pubblica e non richiede token in ingresso.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "mario.rossi@example.com",
                "password": "Password123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login effettuato correttamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "message": "Login utente",
                  "user": {
                    "id": 1,
                    "name": "Mario",
                    "surname": "Rossi",
                    "email": "mario.rossi@example.com",
                    "role": "user"
                  },
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Campi mancanti",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Email e password sono obbligatori"
                }
              }
            }
          },
          "401": {
            "description": "Password non valida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Password non valida"
                }
              }
            }
          },
          "404": {
            "description": "Utente non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Utente non trovato"
                }
              }
            }
          },
          "500": {
            "description": "Errore del server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithDetail"
                },
                "example": {
                  "message": "Errore del server",
                  "specific": "Internal error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Effettua il logout",
        "description": "Logout documentato come operazione protetta da token JWT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout effettuato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                },
                "example": {
                  "message": "Logout effettuato con successo"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Elenco utenti",
        "description": "Restituisce la lista utenti. Per accedere è necessario inviare il token JWT nell'header Authorization come Bearer token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista utenti disponibile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersListResponse"
                },
                "example": {
                  "message": "Lista utenti"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Profilo utente autenticato",
        "description": "Restituisce i dati dell'utente autenticato tramite token JWT inviato nell'header Authorization come Bearer token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profilo utente restituito correttamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "nome": {
                      "type": "string",
                      "example": "Mario"
                    },
                    "cognome": {
                      "type": "string",
                      "example": "Rossi"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "example": "mario.rossi@example.com"
                    },
                    "role": {
                      "type": "string",
                      "example": "user"
                    }
                  },
                  "required": ["id", "nome", "cognome", "email", "role"]
                }
              }
            }
          },
          "401": {
            "description": "Token mancante o non valido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "examples": {
                  "missingToken": {
                    "value": {
                      "message": "Token mancante o formato non valido"
                    }
                  },
                  "invalidToken": {
                    "value": {
                      "message": "Token non valido"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Utente non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Utente non trovato"
                }
              }
            }
          },
          "500": {
            "description": "Errore del server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorWithDetail"
                },
                "example": {
                  "message": "Errore del server",
                  "specific": "Internal error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Aggiorna profilo utente autenticato",
