          "400": {
            "description": "Dati di input non validi o incompleti",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "message": "Tutti i campi sono obbligatori"
                }
              }
            }
